rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMaster() {
      return request.auth != null && request.auth.token.email == 'dancos3@gmail.com' && request.auth.token.email_verified == true;
    }

    // Profiles
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isMaster());
      allow delete: if isMaster();
    }

    // Raffles
    match /raffles/{raffleId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.user_id || isMaster());
    }

    // Orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.ticket_numbers is list
                    && request.resource.data.ticket_numbers.size() > 0
                    && request.resource.data.total_amount is number
                    && request.resource.data.total_amount > 0;
      allow update, delete: if request.auth != null && (
        isMaster() ||
        get(/databases/$(database)/documents/raffles/$(resource.data.raffle_id)).data.user_id == request.auth.uid
      );
    }

    // System Settings & Global Themes
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isMaster();
    }
  }
}
